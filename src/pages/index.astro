---
import Layout from '../layouts/Layout.astro';

// ---- Údaje o studiu (tady se mění kontakty) ----
const studio = {
  name: 'Úleva',
  city: 'Hradec Králové',
  phone: '+420 777 000 000',
  phoneHref: 'tel:+420777000000',
  email: 'info@uleva-masaze.cz',
  street: 'Ulice 12',
  zip: '500 02 Hradec Králové',
  // odkaz na profil na Google Maps (kvůli recenzím)
  googleUrl: 'https://www.google.com/maps/search/mas%C3%A1%C5%BEe+Hradec+Kr%C3%A1lov%C3%A9',
};

// ---- Fotky (ilustrační, nahradit fotkami ze studia) ----
const photos = {
  hero: 'https://images.unsplash.com/photo-1519824145371-296894a0daa9?auto=format&fit=crop&w=1100&q=75',
  stones: 'https://images.unsplash.com/photo-1600334089648-b0d9d3028eb2?auto=format&fit=crop&w=1100&q=75',
};

// ---- Ceník ----
const services = [
  {
    name: 'Klasická masáž',
    text: 'Záda, šíje a ramena. Uvolní ztuhlé svaly po dlouhém sezení u počítače nebo za volantem.',
    prices: [['60 min', '800 Kč'], ['90 min', '1 100 Kč']],
  },
  {
    name: 'Sportovní masáž',
    text: 'Hlubší, důraznější práce se svaly před výkonem nebo po něm. Pro běžce, cyklisty i víkendové sportovce.',
    prices: [['60 min', '900 Kč']],
  },
  {
    name: 'Relaxační masáž s aromaterapií',
    text: 'Pomalé, plynulé tahy a teplý olej s esenciálními oleji podle vaší volby. Když potřebujete hlavně vypnout.',
    prices: [['60 min', '850 Kč'], ['90 min', '1 200 Kč']],
  },
  {
    name: 'Masáž lávovými kameny',
    text: 'Nahřáté čedičové kameny prohřejí svaly do hloubky. Ideální v zimě a při chronickém napětí.',
    prices: [['90 min', '1 300 Kč']],
  },
];

// ---- Recenze ----
// UKÁZKA: před spuštěním nahradit skutečnými recenzemi z Google (jméno, text, počet hvězd)
const reviews = [
  {
    text: 'Chodím kvůli bolavým zádům z kanceláře. Po masáži můžu zase normálně otočit hlavou a úleva vydrží několik týdnů.',
    author: 'Ukázková recenze',
    stars: 5,
  },
  {
    text: 'Dostala jsem poukaz k narozeninám. Klidné prostředí, příjemný přístup a na začátku se mě podrobně vyptala, co mě trápí.',
    author: 'Ukázková recenze',
    stars: 5,
  },
  {
    text: 'Sportovní masáž před půlmaratonem. Důrazná, ale přesně podle domluvy. Objednávám se pravidelně.',
    author: 'Ukázková recenze',
    stars: 5,
  },
];
const isSampleReviews = true; // až budou skutečné recenze, přepsat na false

// ---- Dárkové poukazy (platba přes Stripe Payment Links) ----
// Do "stripe" vlož odkaz ze Stripe (https://buy.stripe.com/...).
// Dokud je prázdný, tlačítko místo platby vytočí telefon.
const vouchers = [
  { name: 'Klasická masáž 60 min', price: '800 Kč', stripe: '' },
  { name: 'Relaxační masáž 90 min', price: '1 200 Kč', stripe: '' },
  { name: 'Lávové kameny 90 min', price: '1 300 Kč', stripe: '' },
  { name: 'Libovolná částka', price: 'od 500 Kč', stripe: '' },
];

const steps = [
  ['Objednáte se', 'Zavoláte nebo napíšete SMS. Termín domluvíme hned, obvykle do několika dnů.'],
  ['Krátce si promluvíme', 'Na začátku se zeptám, co vás trápí a kde to bolí. Masáž přizpůsobím vám.'],
  ['Masáž', 'Teplá místnost, čisté prádlo, klid. Tlak můžete kdykoli upravit.'],
  ['Doporučení na doma', 'Odnesete si pár cviků nebo protažení, aby úleva vydržela déle.'],
];

const hours = [
  ['Pondělí – čtvrtek', '9:00 – 20:00'],
  ['Pátek', '9:00 – 16:00'],
  ['Víkend', 'po domluvě'],
];
---
<Layout
  title={`${studio.name} – masáže ${studio.city}`}
  description={`Masážní studio ${studio.name} v Hradci Králové. Klasické, sportovní, relaxační masáže a lávové kameny. Objednávky na ${studio.phone}.`}
>
  <header class="topbar">
    <div class="wrap topbar-inner">
      <a href="#" class="logo" aria-label="Úleva – úvod">
        <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="4"/><circle cx="16" cy="16" r="9" opacity=".55"/><circle cx="16" cy="16" r="14" opacity=".25"/></svg>
        Úleva
      </a>
      <nav aria-label="Hlavní menu">
        <a href="#cenik">Ceník</a>
        <a href="#recenze">Recenze</a>
        <a href="#jak-to-probiha">Jak to probíhá</a>
        <a href="#poukazy">Poukazy</a>
        <a href="#kontakt">Kontakt</a>
      </nav>
      <a class="topbar-phone" href={studio.phoneHref}>{studio.phone}</a>
    </div>
  </header>

  <main>
    <!-- HERO -->
    <section class="hero">
      <div class="wrap hero-inner">
        <div class="hero-text">
          <p class="hero-place">Masážní studio v Hradci Králové</p>
          <h1>Masáž, po které se vám uleví.</h1>
          <p class="hero-lead">
            Ztuhlá záda, bolavá šíje nebo prostě potřeba na hodinu vypnout.
            Klasické, sportovní i relaxační masáže v klidném studiu kousek od centra.
          </p>
          <div class="hero-actions">
            <a class="btn btn-primary" href={studio.phoneHref}>Zavolat a objednat se</a>
            <a class="btn btn-ghost" href="#cenik">Prohlédnout ceník</a>
          </div>
        </div>

        <div class="hero-photo">
          <svg class="ripple" viewBox="0 0 400 400" aria-hidden="true">
            {[40, 80, 122, 166].map((r, i) => (
              <circle class="ring" style={`--i:${i}`} cx="200" cy="200" r={r} />
            ))}
          </svg>
          <img
            src={photos.hero}
            alt="Masérka uvolňuje klientce svaly na zádech"
            width="1100" height="1300"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>

    <!-- CENÍK -->
    <section id="cenik" class="section">
      <div class="wrap">
        <div class="section-head">
          <h2>Masáže a ceník</h2>
          <p>Ceny jsou konečné, včetně oleje a ručníků. Nevíte, kterou masáž vybrat? Zavolejte a poradím.</p>
        </div>

        <ul class="menu">
          {services.map((s) => (
            <li class="menu-item">
              <div class="menu-desc">
                <h3>{s.name}</h3>
                <p>{s.text}</p>
              </div>
              <dl class="menu-prices">
                {s.prices.map(([d, p]) => (
                  <div><dt>{d}</dt><dd>{p}</dd></div>
                ))}
              </dl>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- RECENZE -->
    <section id="recenze" class="section section-soft">
      <div class="wrap">
        <div class="section-head">
          <h2>Co říkají klienti</h2>
          <p>
            Recenze z Google od lidí, kteří u mě byli.
            <a href={studio.googleUrl} target="_blank" rel="noopener">Zobrazit všechny na Google</a>
          </p>
        </div>

        {isSampleReviews && (
          <p class="sample-note">Ukázka rozložení. Před spuštěním sem vložíme skutečné recenze z Google.</p>
        )}

        <ul class="reviews">
          {reviews.map((r) => (
            <li class="review">
              <span class="stars" aria-label={`${r.stars} z 5 hvězd`}>
                {'★'.repeat(r.stars)}{'☆'.repeat(5 - r.stars)}
              </span>
              <blockquote>{r.text}</blockquote>
              <p class="review-author">{r.author}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- JAK TO PROBÍHÁ -->
    <section id="jak-to-probiha" class="section">
      <div class="wrap process">
        <img
          class="process-photo"
          src={photos.stones}
          alt="Lávové kameny na zádech klienta"
          width="1100" height="1300"
          loading="lazy"
        />
        <div>
          <h2>Jak to probíhá</h2>
          <p class="process-lead">Poprvé na masáži? Nic složitého, stačí přijít v pohodlném oblečení.</p>
          <ol class="steps">
            {steps.map(([t, d]) => (
              <li>
                <h3>{t}</h3>
                <p>{d}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- POUKAZ -->
    <section id="poukazy" class="voucher">
      <div class="wrap">
        <div class="voucher-head">
          <h2>Darujte hodinu klidu</h2>
          <p>
            Dárkový poukaz zaplatíte online kartou, Apple Pay nebo Google Pay.
            Poukaz vám pošlu e-mailem do 24 hodin, platí 6 měsíců.
          </p>
        </div>
        <ul class="voucher-list">
          {vouchers.map((v) => (
            <li class="voucher-item">
              <div>
                <h3>{v.name}</h3>
                <p class="voucher-price">{v.price}</p>
              </div>
              {v.stripe ? (
                <a class="btn btn-amber" href={v.stripe} target="_blank" rel="noopener">Koupit poukaz</a>
              ) : (
                <a class="btn btn-amber" href={studio.phoneHref}>Zavolat</a>
              )}
            </li>
          ))}
        </ul>
        <p class="voucher-secure">Platba probíhá přes zabezpečenou bránu Stripe. Údaje o kartě nevidíme.</p>
      </div>
    </section>

    <!-- KONTAKT -->
    <section id="kontakt" class="section">
      <div class="wrap contact">
        <div class="contact-main">
          <h2>Kde mě najdete</h2>
          <address>
            {studio.street}<br />{studio.zip}
          </address>
          <p class="contact-note">Parkování přímo před domem. Studio je v přízemí, bez schodů.</p>
          <div class="contact-links">
            <a class="contact-big" href={studio.phoneHref}>{studio.phone}</a>
            <a href={`mailto:${studio.email}`}>{studio.email}</a>
          </div>
        </div>

        <div class="contact-hours">
          <h3>Otevírací doba</h3>
          <dl>
            {hours.map(([d, t]) => (
              <div><dt>{d}</dt><dd>{t}</dd></div>
            ))}
          </dl>
          <p class="contact-note">Masíruji jen na objednávku, proto prosím vždy zavolejte předem.</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer-inner">
      <span>© {new Date().getFullYear()} Masáže Úleva, {studio.city}</span>
      <a href={studio.phoneHref}>{studio.phone}</a>
    </div>
  </footer>
</Layout>

<style>
  .wrap {
    max-width: var(--max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* --- Top bar --- */
  .topbar {
    background: rgb(250 250 248 / 0.92);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--line);
  }
  .topbar-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 4rem;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--serif);
    font-size: 1.4rem;
    text-decoration: none;
    color: var(--forest);
  }
  .logo svg { width: 1.6rem; height: 1.6rem; fill: none; stroke: var(--amber); stroke-width: 2; }
  .topbar nav { display: flex; gap: 1.5rem; margin-left: auto; }
  .topbar nav a {
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--ink-soft);
  }
  .topbar nav a:hover { color: var(--forest); text-decoration: underline; text-underline-offset: 4px; }
  .topbar-phone {
    font-weight: 600;
    font-size: var(--step--1);
    text-decoration: none;
    color: var(--forest);
    white-space: nowrap;
  }

  /* --- Hero --- */
  .hero { overflow: hidden; }
  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0,1.1fr) minmax(0,1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }
  .hero-place {
    color: var(--moss);
    font-weight: 500;
    margin-bottom: 1.25rem;
  }
  .hero h1 {
    font-size: var(--step-4);
    color: var(--forest);
    max-width: 15ch;
    letter-spacing: -0.01em;
  }
  .hero-lead {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2.25rem; }

  .hero-photo { position: relative; }
  .hero-photo img {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 12rem 12rem 1.25rem 1.25rem;
    background: var(--sage);
  }
  .ripple {
    position: absolute;
    width: 70%;
    left: -22%;
    z-index: 1;
    pointer-events: none;
    bottom: -14%;
    overflow: visible;
  }
  .ring {
    fill: none;
    stroke: var(--amber);
    stroke-width: 1.5;
    opacity: calc(0.7 - var(--i) * 0.14);
    transform-box: view-box;
    transform-origin: 200px 200px;
    animation: spread 1.8s cubic-bezier(.2,.7,.2,1) both;
    animation-delay: calc(0.3s + var(--i) * 0.12s);
  }
  @keyframes spread {
    from { scale: 0.3; opacity: 0; }
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.1rem;
    padding: 0 1.5rem;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color .2s, color .2s, border-color .2s;
  }
  .btn-primary { background: var(--forest); color: #fff; }
  .btn-primary:hover { background: var(--forest-deep); }
  .btn-ghost { border: 1.5px solid var(--line); color: var(--ink); }
  .btn-ghost:hover { border-color: var(--forest); }
  .btn-amber { background: var(--amber); color: var(--forest-deep); }
  .btn-amber:hover { background: #E6B670; }

  /* --- Sections --- */
  .section { padding-block: clamp(4rem, 9vw, 6.5rem); }
  .section-soft { background: var(--sage); }
  .section-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: end;
    margin-bottom: 3rem;
  }
  .section-head h2 { font-size: var(--step-3); color: var(--forest); }
  .section-head p { color: var(--ink-soft); max-width: 32rem; }
  .section-head a { color: var(--forest); font-weight: 600; text-underline-offset: 3px; }

  /* --- Ceník jako menu --- */
  .menu { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--ink); }
  .menu-item {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--line);
  }
  .menu-desc h3 { font-size: var(--step-2); color: var(--ink); }
  .menu-desc p { margin-top: 0.5rem; color: var(--ink-soft); max-width: 38rem; }
  .menu-prices { margin: 0; display: flex; flex-direction: column; gap: 0.35rem; min-width: 11rem; }
  .menu-prices div { display: flex; justify-content: space-between; gap: 1.5rem; }
  .menu-prices dt { color: var(--ink-soft); }
  .menu-prices dd { margin: 0; font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }

  /* --- Recenze --- */
  .sample-note {
    margin: -1.5rem 0 1.5rem;
    font-size: var(--step--1);
    color: #8A5A16;
    background: #F6E7CF;
    border-radius: 999px;
    padding: 0.4rem 1rem;
    display: inline-block;
  }
  .reviews {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .review {
    background: #fff;
    border-radius: 1.25rem;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
  }
  .stars { color: var(--amber); letter-spacing: 0.15em; font-size: 1.1rem; }
  .review blockquote {
    margin: 1rem 0 1.5rem;
    font-family: var(--serif);
    font-size: 1.15rem;
    line-height: 1.5;
    color: var(--ink);
  }
  .review-author { margin-top: auto; font-size: var(--step--1); color: var(--ink-soft); font-weight: 500; }

  /* --- Postup --- */
  .process {
    display: grid;
    grid-template-columns: minmax(0,0.8fr) minmax(0,1.2fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .process-photo {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 1.25rem;
    background: var(--sage);
  }
  .process h2 { font-size: var(--step-3); color: var(--forest); }
  .process-lead { color: var(--ink-soft); margin-top: 0.75rem; }
  .steps {
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem 2.5rem;
    counter-reset: step;
  }
  .steps li { counter-increment: step; border-top: 1.5px solid var(--ink); padding-top: 1.1rem; }
  .steps li::before {
    content: counter(step);
    display: block;
    font-family: var(--serif);
    font-size: var(--step-2);
    color: var(--amber);
    margin-bottom: 0.5rem;
  }
  .steps h3 { font-size: var(--step-1); color: var(--ink); }
  .steps p { margin-top: 0.5rem; color: var(--ink-soft); font-size: 1rem; }

  /* --- Poukaz --- */
  .voucher { background: var(--forest); color: var(--sage); }
  .voucher { padding-block: clamp(3.5rem, 8vw, 5.5rem); }
  .voucher-head h2 { font-size: var(--step-3); color: #fff; }
  .voucher-head p { margin-top: 0.75rem; max-width: 38rem; color: rgb(236 238 234 / 0.85); }
  .voucher-list {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }
  .voucher-item {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem;
    border: 1px solid rgb(236 238 234 / 0.22);
    border-radius: 1.25rem;
  }
  .voucher-item h3 { font-size: var(--step-1); color: #fff; }
  .voucher-price { margin-top: 0.35rem; font-weight: 600; color: var(--amber); }
  .voucher-item .btn { width: 100%; padding-inline: 1rem; text-align: center; white-space: nowrap; }
  .voucher-secure { margin-top: 1.5rem; font-size: var(--step--1); color: rgb(236 238 234 / 0.65); }

  /* --- Kontakt --- */
  .contact { display: grid; grid-template-columns: 1.3fr 1fr; gap: 3rem; }
  .contact h2 { font-size: var(--step-3); color: var(--forest); }
  .contact address { font-style: normal; font-size: var(--step-1); margin-top: 1.25rem; }
  .contact-note { color: var(--ink-soft); margin-top: 1rem; font-size: 1rem; }
  .contact-links { display: flex; flex-direction: column; gap: 0.4rem; margin-top: 2rem; }
  .contact-big {
    font-family: var(--serif);
    font-size: var(--step-3);
    color: var(--forest);
    text-decoration: none;
  }
  .contact-big:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .contact-hours {
    background: var(--sage);
    border-radius: 1.25rem;
    padding: 2rem;
    align-self: start;
  }
  .contact-hours h3 { font-size: var(--step-1); color: var(--ink); margin-bottom: 1rem; }
  .contact-hours dl { margin: 0; }
  .contact-hours dl div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--line);
  }
  .contact-hours dd { margin: 0; font-weight: 600; }

  /* --- Patička --- */
  .footer { background: var(--ink); color: rgb(236 238 234 / 0.7); font-size: var(--step--1); }
  .footer-inner { display: flex; justify-content: space-between; gap: 1rem; padding-block: 1.5rem; flex-wrap: wrap; }
  .footer a { text-decoration: none; }

  /* --- Mobil --- */
  @media (max-width: 860px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-photo { max-width: 26rem; justify-self: center; width: 100%; }
    .ripple { left: -12%; }
    .section-head { grid-template-columns: 1fr; gap: 0.75rem; }
    .reviews { grid-template-columns: 1fr; }
    .process { grid-template-columns: 1fr; }
    .process-photo { aspect-ratio: 16 / 10; }
    .contact { grid-template-columns: 1fr; }
    .voucher-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .topbar nav { display: none; }
    .topbar-phone { margin-left: auto; }
